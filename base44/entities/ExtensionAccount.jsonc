{
  "name": "ExtensionAccount",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "password_salt": {
      "type": "string"
    },
    "password_hash": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blacklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_synced_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_synced_blacklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_password": {
      "type": "boolean",
      "description": "False while the account was created via a provider sign-in and no password has been chosen yet"
    },
    "linked_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "email"
        ]
      },
      "description": "Provider identities connected to this account (provider + email), so any of them signs into it"
    },
    "linked_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of connected provider identities, kept flat for sign-in lookup"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note about this account, up to 1000 characters"
    }
  },
  "required": [
    "email",
    "password_salt",
    "password_hash",
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}