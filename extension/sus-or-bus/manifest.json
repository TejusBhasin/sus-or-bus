{
  "manifest_version": 3,
  "name": "Sus or Bus — website safety check",
  "version": "1.6.2",
  "description": "Before you open a website see its SUS or BUS rating and decide whether to continue",
  "permissions": ["storage", "contextMenus", "notifications"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sus or Bus"
  },
  "commands": {
    "check-current-page": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Check the safety of the current page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}