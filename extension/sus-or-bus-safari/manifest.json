{
  "manifest_version": 3,
  "name": "Sus or Bus — website safety check",
  "version": "1.2.0",
  "description": "Before you open a website — from a link, a search result, a bookmark or a pinned tab — see its SUS or BUS rating and decide whether to continue.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}